{
  "name": "vms-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 13000",
    "build": "next build && node scripts/package.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:live-mosaic": "node --experimental-strip-types --test tests/live-mosaic.node.mjs",
    "test:recording-timeline": "node --experimental-strip-types --test tests/recording-timeline.node.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "hls.js": "1.7.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
