[Unit]
Description=Astra HTTPS gateway and API
After=network-online.target postgresql@16-main.service astra-web.service astra-media.service
Wants=network-online.target postgresql@16-main.service astra-web.service astra-media.service
RequiresMountsFor=/var/lib/astra/core
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=astra-core
Group=astra-core
WorkingDirectory=/var/lib/astra/core
EnvironmentFile=/etc/astra/core.env
ExecStart=/opt/astra/current/bin/vms --data /var/lib/astra/core --listen ${ASTRA_LISTEN} --tls-host ${ASTRA_PUBLIC_HOST}
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/astra/core
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
