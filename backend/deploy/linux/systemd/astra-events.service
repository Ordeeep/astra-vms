[Unit]
Description=Astra camera event collector
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/astra/events
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=astra-events
Group=astra-events
WorkingDirectory=/var/lib/astra/events
EnvironmentFile=/etc/astra/media.env
ExecStart=/opt/astra/current/bin/vms-event-worker --data /var/lib/astra/events
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/astra/events
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
